# Menu Master NG — frontend environment
# Copy to .env.local. NEVER commit .env.local. NEVER put a service_role key or
# a Paystack secret key here: anything prefixed NEXT_PUBLIC_ is shipped to the
# browser, and this file is the browser's half of the system.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where Supabase should send users back after email confirmation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# BILLING SECRETS DO NOT BELONG HERE, OR IN VERCEL AT ALL.
#
# /api/checkout holds no credential. It proves the caller is signed in and
# forwards their own token to the paystack-checkout Edge Function, which is
# where the Paystack key lives — one place, next to the webhook that already
# uses it, so a Vercel preview deployment cannot leak it.
#
# Set these in the Supabase Edge Function secret store, never in a file:
#
#   supabase secrets set PAYSTACK_SECRET_KEY=...     # sk_test_ first, sk_live_ later
#   supabase secrets set SITE_URL=https://menumasterng.com
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform and
# must not be set by hand.
# ----------------------------------------------------------------------------
