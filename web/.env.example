# Menu Master NG — frontend environment
# Copy to .env.local. NEVER commit .env.local. NEVER put a service_role key here:
# anything prefixed NEXT_PUBLIC_ is shipped to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where Supabase should send users back after email confirmation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
